#VRML_SIM R2025a utf8
# 具身养老/社区巡检机器人仿真 —— 基础节点版本（零 PROTO / 零联网）
# 全部使用 Webots 内置基础节点手写，不引用任何外部 .proto 文件。
# 控制器: webots_controller（自动发现设备 + 红色异常检测闭环）

WorldInfo {
  basicTimeStep 16
  info [
    "AI+公共服务赛道 - 具身巡检机器人仿真"
    "基础节点版本：不依赖任何 PROTO，离线可用"
  ]
}

Viewpoint {
  orientation -0.4619398 0.3314136 0.8213938 0.6981317
  position 4.5 4.5 4
}

Background {
  skyColor [ 0.6 0.75 0.95 ]
}

DirectionalLight {
  direction 0.5 -1 0.3
  intensity 1.0
  ambientIntensity 0.4
}

# 社区地面（12x12 米），提供碰撞支撑
DEF FLOOR Solid {
  translation 0 0 -0.01
  children [
    Shape {
      geometry Box { size 12 12 0.02 }
      appearance Appearance {
        material Material { diffuseColor 0.82 0.82 0.78 }
      }
    }
  ]
  boundingObject Box { size 12 12 0.02 }
  physics Physics { }
}

# 测试用“跌倒人员”标记（红色方块），放在巡逻边线附近、斜前方可见
DEF FALLEN_MARKER Transform {
  translation 1.5 0.3 0.125
  children [
    Shape {
      geometry Box { size 0.25 0.25 0.25 }
      appearance Appearance {
        material Material { diffuseColor 0.9 0.1 0.1 }
      }
    }
  ]
}

# 巡逻机器人：基础节点手写两轮差速模型
# 轮子命名 left wheel / right wheel（含 left/right 关键字的电机与编码器会被控制器识别）
# 轮半径 0.0975、轮距 0.331 —— 与控制器 WHEEL_RADIUS / WHEELBASE 一致
DEF PATROL_BOT Robot {
  translation 0 0 0
  controller "webots_controller"
  children [
    # 机器人本体
    Transform {
      translation 0 0 0.2
      children [
        Shape {
          geometry Box { size 0.4 0.36 0.2 }
          appearance Appearance {
            material Material { diffuseColor 0.15 0.35 0.7 }
          }
        }
      ]
    }
    # 前置摄像头，朝向 +x（机器人前进方向）
    Camera {
      translation 0.22 0 0.2
      rotation 0 1 0 -1.5708
      width 320
      height 240
    }
    # 左轮
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 }
      device [
        RotationalMotor { name "left wheel" }
        PositionSensor { name "left wheel sensor" }
      ]
      endPoint Solid {
        translation 0 0.1655 0.0975
        children [
          Shape {
            geometry Cylinder { radius 0.0975 height 0.05 }
            appearance Appearance {
              material Material { diffuseColor 0.12 0.12 0.12 }
            }
          }
        ]
        boundingObject Cylinder { radius 0.0975 height 0.05 }
        physics Physics { }
      }
    }
    # 右轮
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 }
      device [
        RotationalMotor { name "right wheel" }
        PositionSensor { name "right wheel sensor" }
      ]
      endPoint Solid {
        translation 0 -0.1655 0.0975
        children [
          Shape {
            geometry Cylinder { radius 0.0975 height 0.05 }
            appearance Appearance {
              material Material { diffuseColor 0.12 0.12 0.12 }
            }
          }
        ]
        boundingObject Cylinder { radius 0.0975 height 0.05 }
        physics Physics { }
      }
    }
  ]
  boundingObject Transform {
    translation 0 0 0.2
    children [
      Box { size 0.4 0.36 0.2 }
    ]
  }
  physics Physics { }
}
